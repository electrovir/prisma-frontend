{
    "name": "prisma-frontend",
    "version": "1.0.3",
    "description": "A Prisma generator for creating frontend-friendly exports (types and enums).",
    "keywords": [
        "prisma",
        "generator",
        "frontend",
        "enums",
        "types"
    ],
    "homepage": "https://github.com/electrovir/prisma-frontend",
    "bugs": {
        "url": "https://github.com/electrovir/prisma-frontend/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/prisma-frontend.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": "bin.js",
    "scripts": {
        "compile": "virmator compile",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "txs src/index.ts",
        "test": "virmator test node src/generator/generator.test.ts && virmator test web src/frontend.test.ts",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,deps,lint \"npm run test:coverage\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.17.1",
        "@augment-vir/common": "^31.17.1",
        "@augment-vir/node": "^31.17.1",
        "tsx": "^4.19.4"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.17.1",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "9.26.0",
        "@prisma/client": "^6.7.0",
        "@prisma/generator-helper": "^6.7.0",
        "@prisma/internals": "^6.7.0",
        "@stylistic/eslint-plugin": "^4.2.0",
        "@stylistic/eslint-plugin-ts": "^4.2.0",
        "@types/node": "^22.15.17",
        "@typescript-eslint/eslint-plugin": "^8.32.0",
        "@web/dev-server-esbuild": "^1.0.4",
        "@web/test-runner": "^0.20.1",
        "@web/test-runner-commands": "^0.9.0",
        "@web/test-runner-playwright": "^0.11.0",
        "@web/test-runner-visual-regression": "^0.10.0",
        "cspell": "^9.0.1",
        "dependency-cruiser": "^16.10.2",
        "esbuild": "^0.25.4",
        "eslint": "9.26.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-jsdoc": "^50.6.11",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.2.0",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.2",
        "eslint-plugin-unicorn": "^59.0.1",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^18.0.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.3.2",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-packagejson": "^2.5.11",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.5",
        "prisma": "^6.7.0",
        "prisma-frontend": "./",
        "type-fest": "^4.41.0",
        "typedoc": "^0.28.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.0",
        "virmator": "^13.15.1"
    },
    "peerDependencies": {
        "@prisma/generator-helper": "*",
        "@prisma/internals": "*"
    },
    "engines": {
        "node": ">=22"
    }
}
